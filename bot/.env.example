# Copy to .env and fill in. .env is gitignored -- never commit it.
#   cp .env.example .env

# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
TOKEN=

# Numeric server ID where the slash commands live. Enable Developer Mode in
# Discord, right-click the server, "Copy Server ID".
GUILD=

# Where the RimWorld mod listens. The port is hardcoded on the mod side
# (ServerComponent.cs, "localhost:9891"), so both ends must agree.
SERVER=http://localhost:9891/
